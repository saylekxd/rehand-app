{
  "expo": {
    "name": "Rehand",
    "slug": "rehand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rehand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saylekxd.rehand",
      "infoPlist": {
        "NSCameraUsageDescription": "Potrzebujemy dostępu do kamery, aby analizować Twoje ćwiczenia w czasie rzeczywistym.",
        "NSMicrophoneUsageDescription": "Potrzebujemy dostępu do mikrofonu podczas nagrywania wideo do analizy ruchu."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "rehand-app",
          "organization": "swtlabs-vn"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd3baeb-8bba-48a1-b775-d99820c92b49"
      },
      "supabaseUrl": "https://ihgfxnyppyoitmzdexic.supabase.co",
      "supabaseKey": "sb_publishable_oK6KLv7brZYI7EauI00PDQ_Ey-tWUw8"
    },
    "android": {
      "package": "com.saylekxd.rehand"
    }
  }
}
