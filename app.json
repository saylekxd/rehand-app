{
  "expo": {
    "name": "Rehand",
    "slug": "rehand",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rehand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saylekxd.rehand",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera służy wyłącznie do analizy ruchu w czasie ćwiczeń. Obraz nie jest nagrywany ani wysyłany poza urządzenie."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd3baeb-8bba-48a1-b775-d99820c92b49"
      },
      "supabaseUrl": "https://ihgfxnyppyoitmzdexic.supabase.co",
