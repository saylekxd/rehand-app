{
  "expo": {
    "name": "Rehand",
    "slug": "rehand",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rehand",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saylekxd.rehand",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used only for real-time movement analysis during exercises. No image is recorded or sent off device.",
        "NSPhotoLibraryUsageDescription": "We need access to your photo library so you can choose a profile picture.",
        "NSLocalNetworkUsageDescription": "The app needs access to your local network to connect to the development server during development.",
        "NSLocationWhenInUseUsageDescription": "This app does not use your location. If prompted, you can deny; the app will still work."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd3baeb-8bba-48a1-b775-d99820c92b49"
      },
      "supabaseUrl": "https://ihgfxnyppyoitmzdexic.supabase.co",
      "supabaseKey": "sb_publishable_oK6KLv7brZYI7EauI00PDQ_Ey-tWUw8",
      "termsUrl": "https://saylekxd.notion.site/Rehand-Terms-Of-Service-7c2a3f94f7d44a5285b0d0f7a3e5f6e1",
      "privacyUrl": "https://saylekxd.notion.site/Rehand-Privacy-Policy-5b8d1d4a3f464a8a8df389a4e76e1c7e",
      "eulaUrl": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/"
    },
    "android": {
      "package": "com.saylekxd.rehand"
    }
  }
}
